;;;###autoload
(defun daut/minibuffer-backward-kill (arg)
  (interactive "p")
  (if (and minibuffer-completing-file-name
       (eq (char-before) ?/))
  (zap-up-to-char (- arg) ?/)
    (delete-backward-char arg)))

